# Solo lectura publica; no habilita crear/cancelar reservas sin identidad verificada.
AGENDA_PUBLIC_READ_ENABLED=True
AGENDA_PUBLIC_REQUEST_LIMIT=60
# Solicitudes online sin correo/SMS; requieren confirmacion del personal.
AGENDA_PUBLIC_WRITE_ENABLED=False
# Decision de negocio: citas nuevas sin anticipo; no modifica historicos.
AGENDA_REQUIRE_DEPOSITS=False
