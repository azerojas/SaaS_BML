DJANGO_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET
DATABASE_URL=postgresql://beauty_runtime:REPLACE_RUNTIME_SECRET@staging-db.railway.internal:5432/beauty_staging
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/database-ca.pem
ALLOWED_HOSTS=staging.REPLACE_DOMAIN,healthcheck.railway.app,localhost
CSRF_TRUSTED_ORIGINS=https://staging.REPLACE_DOMAIN
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HTTPS=False
MFA_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
PRIVACY_NOTICE_URL=https://staging.REPLACE_DOMAIN/privacy/
PRIVACY_NOTICE_VERSION=REPLACE_APPROVED_NOTICE_VERSION
PUBLIC_CHECKIN_URL=https://staging.REPLACE_DOMAIN/api/public/checkin/
CHECKIN_PRIVACY_NOTICE_URL=https://staging.REPLACE_DOMAIN/privacy/
CHECKIN_PRIVACY_NOTICE_VERSION=REPLACE_APPROVED_NOTICE_VERSION
CHECKIN_DEMO_MODE=False
ALLOW_MAINTENANCE_JOBS=False
HEALTHCHECK_HOST=localhost
PORT=8000
