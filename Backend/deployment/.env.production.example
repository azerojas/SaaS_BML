DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=REPLACE_WITH_PRODUCTION_ONLY_RANDOM_SECRET
DATABASE_URL=postgresql://beauty_runtime:REPLACE_RUNTIME_SECRET@production-db.railway.internal:5432/beauty_production
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/database-ca.pem
ALLOWED_HOSTS=REPLACE_PRODUCTION_DOMAIN,healthcheck.railway.app,localhost
CSRF_TRUSTED_ORIGINS=https://REPLACE_PRODUCTION_DOMAIN
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HTTPS=False
MFA_ENCRYPTION_KEY=REPLACE_WITH_PRODUCTION_ONLY_FERNET_KEY
PRIVACY_NOTICE_URL=https://REPLACE_PRODUCTION_DOMAIN/privacy/
PRIVACY_NOTICE_VERSION=REPLACE_APPROVED_NOTICE_VERSION
PUBLIC_CHECKIN_URL=https://REPLACE_PRODUCTION_DOMAIN/api/public/checkin/
CHECKIN_PRIVACY_NOTICE_URL=https://REPLACE_PRODUCTION_DOMAIN/privacy/
CHECKIN_PRIVACY_NOTICE_VERSION=REPLACE_APPROVED_NOTICE_VERSION
CHECKIN_DEMO_MODE=False
ALLOW_MAINTENANCE_JOBS=False
HEALTHCHECK_HOST=localhost
PORT=8000
