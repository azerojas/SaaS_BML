FROM python:3.14.10-alpine3.23@sha256:0cdfadc8472de8f74a5d3c6e5e49d1b3f059f36cd01a0a0d4015cb1cb89df436
RUN apk upgrade --no-cache && apk add --no-cache postgresql18-client tzdata
COPY requirements-backup.txt /tmp/requirements-backup.txt
RUN pip install --no-cache-dir -r /tmp/requirements-backup.txt
RUN rm -rf /usr/local/lib/python3.14/site-packages/pip* /usr/local/lib/python3.14/ensurepip /usr/local/bin/pip*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PG_BIN=/usr/bin
WORKDIR /app
COPY scripts/backup_database.py scripts/backup_common.py scripts/restore_verify.py scripts/
COPY apps/operaciones/infrastructure/backup_crypto.py apps/operaciones/infrastructure/
COPY config/environment.py config/environment.py
COPY deployment/backup_job.py deployment/
RUN addgroup -g 10001 beauty && adduser -D -u 10001 -G beauty beauty && mkdir /backups && chown 10001:10001 /backups
USER 10001:10001
ENTRYPOINT ["python", "deployment/backup_job.py"]
