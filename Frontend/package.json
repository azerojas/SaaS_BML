    "start": "node scripts/serve.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/format.mjs --write",
